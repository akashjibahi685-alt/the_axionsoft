// Prisma Schema for AXIONSOFT SOLUTION
// Production-ready resilient relational schema supporting PostgreSQL & SQLite/LibSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  avatarUrl    String?
  isActive     Boolean     @default(true)
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String      @id @default(cuid())
  name        String      @unique // SUPER_ADMIN, ADMIN, EDITOR, VIEWER
  description String?
  permissions String      @default("[]") // JSON string of permission keys
  users       AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  order       Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([order])
}

model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  tagline          String?
  shortDesc        String
  description      String
  icon             String          @default("Code")
  businessProblems String          @default("[]") // JSON array of problems
  solutions        String          @default("[]") // JSON array of solutions
  process          String          @default("[]") // JSON array of steps
  technologies     String          @default("[]") // JSON array of tech strings
  faqs             String          @default("[]") // JSON array of {q, a}
  order            Int             @default(0)
  isPublished      Boolean         @default(true)
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished, order])
  @@index([categoryId, isPublished])
}

model ProjectCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

model Project {
  id           String          @id @default(cuid())
  slug             String          @unique
  title        String
  shortDesc    String
  description  String
  clientName   String?
  coverImage   String
  gallery      String          @default("[]") // JSON array of image URLs
  challenge    String
  solution     String
  process      String          @default("[]") // JSON array of steps
  technologies String          @default("[]") // JSON array of tech strings
  results      String?
  projectDate  String?
  projectUrl   String?
  isFeatured   Boolean         @default(false)
  isPublished  Boolean         @default(true)
  order        Int             @default(0)
  categoryId   String
  category     ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isPublished, order])
  @@index([isPublished, isFeatured, order])
  @@index([categoryId, isPublished])
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  tagline     String
  category    String           @default("AI & Automation")
  description String
  status      String           @default("Active Development") // Alpha, Beta, Live, Concept
  logoUrl     String?
  coverImage  String?
  screenshots String           @default("[]") // JSON array of URLs
  demoUrl     String?
  docsUrl     String?
  pricingInfo String?
  isFeatured  Boolean          @default(false)
  isPublished Boolean          @default(true)
  order       Int              @default(0)
  features    ProductFeature[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([slug])
  @@index([isPublished, order])
  @@index([isFeatured])
  @@index([status])
}

model ProductFeature {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([order])
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([slug])
}

model BlogPost {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String
  content     String
  coverImage  String
  readTime    String       @default("5 min read")
  authorName  String       @default("AxionSoft Engineering Team")
  authorRole  String       @default("Technical Research")
  isFeatured  Boolean      @default(false)
  isPublished Boolean      @default(true)
  publishedAt DateTime     @default(now())
  tags        String       @default("[]") // JSON array
  categoryId  String
  category    BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished, publishedAt])
  @@index([categoryId, isPublished])
  @@index([isFeatured])
}

model Inquiry {
  id                 String   @id @default(cuid())
  fullName           String
  businessEmail      String
  companyName        String?
  phone              String?
  serviceRequired    String
  budget             String?
  timeline           String?
  projectDescription String
  status             String   @default("NEW") // NEW, IN_REVIEW, CONTACTED, ARCHIVED
  internalNotes      String?
  isArchived         Boolean  @default(false)
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([businessEmail])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([isArchived])
}

model CareerApplication {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  roleApplied  String
  portfolioUrl String?
  resumeUrl    String?
  coverNote    String?
  status       String   @default("PENDING") // PENDING, REVIEWED, SHORTLISTED, REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([status, createdAt])
  @@index([email])
  @@index([createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int      // file size in bytes
  url          String
  altText      String?
  checksum     String?  // SHA-256 hash for deduplication
  width        Int?     // pixel width for images
  height       Int?     // pixel height for images
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mimeType])
  @@index([createdAt])
  @@index([checksum])
}

model CompanySetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // text or JSON encoded string
  type        String   @default("STRING") // STRING, NUMBER, BOOLEAN, JSON
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String     // CREATE, UPDATE, DELETE, LOGIN, SETTINGS_CHANGE
  entityType  String     // Project, Service, Product, BlogPost, Settings, etc.
  entityId    String?
  details     String?    // JSON string description
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([adminUserId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, createdAt])
}

// Enterprise Newsletter Subscriptions
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  source       String   @default("FOOTER") // FOOTER, INSIGHTS, MODAL
  ipAddress    String?
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([isActive, subscribedAt])
}

// Telemetry & Runtime Health Observability
model SystemHealthMetric {
  id         String   @id @default(cuid())
  metricType String   // DB_PING, MEMORY_RSS, CACHE_PURGE, API_LATENCY
  value      Float
  unit       String   @default("ms") // ms, MB, count
  status     String   @default("HEALTHY") // HEALTHY, WARN, CRITICAL
  metadata   String?  // JSON string
  recordedAt DateTime @default(now())

  @@index([metricType, recordedAt])
  @@index([status])
}

// Immutable Database Snapshot & Backup Audit Log
model DatabaseBackupLog {
  id          String   @id @default(cuid())
  fileName    String
  fileSize    Int      // bytes
  checksum    String   // sha256
  driver      String   // sqlite, postgresql
  status      String   @default("COMPLETED") // COMPLETED, FAILED
  recordCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}
